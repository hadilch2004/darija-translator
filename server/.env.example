# Copy to server/.env and edit. scripts/run-server.sh loads it automatically.
# server/.env is git-ignored: never commit real keys or passwords.

# --- login required by every client (HTTP Basic) ---------------------------------------------
API_USERNAME=student
# If left empty a random password is generated and printed at start-up.
API_PASSWORD=change-me-please

# --- which LLM translates:  gemini | ollama | mock --------------------------------------------
LLM_PROVIDER=gemini

# Gemini (free tier): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier model names change over time. If you get "llm_model_not_found", pick a current Flash
# model from https://ai.google.dev/gemini-api/docs/models and put its id here.
GEMINI_MODEL=gemini-flash-lite-latest

# Ollama (local, offline): install from https://ollama.com, then `ollama pull llama3.2`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- server ------------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
MAX_TEXT_LENGTH=5000
LLM_TIMEOUT_SECONDS=45
# Use a specific origin (e.g. https://my-site.example) to restrict browser access.
CORS_ALLOWED_ORIGIN=*
